    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.10.1",
    "langchain": "^1.4.1",
    "mammoth": "^1.12.0",
