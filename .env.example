# ===========================================
# POSTLY ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
#
# LOCAL DEV:   Use localhost:5433 (PG) / localhost:6380 (Redis)
#              → First start monitoring stack:
#                cd ../monitoring && docker-compose up -d
# DOCKER PROD: Use container names (postgres, redis) over monitoring_nw
#              → Monitoring stack must be running & network must exist
#
# All DB/Redis credentials MUST match the values in monitoring/.env
# ===========================================

# Environment
NODE_ENV=development

# ===========================================
# DATABASE (PostgreSQL with pgvector)
# ── via monitoring/ shared stack ──
# ===========================================
# Local dev:  postgresql://postly:${POSTLY_DB_PASSWORD}@localhost:5433/postly
# Docker:     postgresql://postly:${POSTLY_DB_PASSWORD}@postgres:5432/postly
DATABASE_URL=postgresql://postly:POSTLY_DB_PASSWORD@localhost:5433/postly
DB_HOST=localhost
DB_PORT=5433
DB_NAME=postly
DB_USER=postly
DB_PASSWORD=POSTLY_DB_PASSWORD

# ===========================================
# DATABASE POOL
# ===========================================
DB_POOL_MAX=8
DB_IDLE_TIMEOUT=10000
DB_CONN_TIMEOUT=2000

# ===========================================
# REDIS (Job Queue & Caching via BullMQ)
# ── via monitoring/ shared stack, DB index 1 ──
# ===========================================
# Local dev:  redis://:${REDIS_PASSWORD}@localhost:6380/1
# Docker:     redis://:${REDIS_PASSWORD}@redis:6379/1
REDIS_URL=redis://:REDIS_PASSWORD@localhost:6380/1
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=REDIS_PASSWORD

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate secrets with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# AI PROVIDERS
# ===========================================
# OpenAI — used for AI chat, resume analysis, match explanations
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Voyage AI — used for embeddings (vector search for job matching)
VOYAGE_API_KEY=your-voyage-api-key-here
VOYAGE_MODEL=voyage-4-lite

# ===========================================
# SERVER URLS
# ===========================================
API_PORT=3000
API_URL=http://localhost:3000
WEB_PORT=3001
WEB_URL=http://localhost:3001
VITE_API_URL=http://localhost:3000

# ===========================================
# EMAIL (Resend — OTP verification, notifications)
# ===========================================
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Postly <onboarding@resend.dev>

# ===========================================
# DISCORD BOT
# ===========================================
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# ===========================================
# REDDIT BOT
# ===========================================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=postly-bot/1.0

# ===========================================
# DODO PAYMENTS (Subscriptions & Billing)
# ===========================================
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3001/dashboard

# ===========================================
# CLOUDINARY (Media Storage — replaces MinIO)
# ===========================================
# Postly uses Cloudinary for all image/media uploads.
# Get your credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

